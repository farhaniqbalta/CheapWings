# Source this file in BOTH API and worker shells (the app does not auto-load .env).
APP_ENV=local
DATABASE_URL=sqlite:///./data/cheapwings.db
API_BIND_HOST=127.0.0.1
API_BIND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ENABLED_PROVIDERS=fake
MAX_ROUTE_DATE_COMBINATIONS=120
GLOBAL_MAX_ACTIVE_SEARCH_JOBS=2
MAX_HOURLY_SEARCH_JOBS=20
JOB_BUDGET_SECONDS=1800
PROVIDER_TIMEOUT_SECONDS=30
WORK_LEASE_SECONDS=40
MAX_WORK_ATTEMPTS=3
# Set a random secret of >=32 characters before any non-loopback/private tunnel use.
# CHEAPWINGS_OWNER_TOKEN=
# Real providers are opt-in and cannot be mixed with fake. Accepted personal scope only.
# ENABLED_PROVIDERS=skiplagged,swoop
CHEAPWINGS_USE_SCOPE=personal
JOB_REPRICE_BUDGET=20
LIVE_RETENTION_SECONDS=3600
# Concurrency=1; fake spacing=1s, real-provider spacing=15s. No live calls in default tests.
LIVE_CANARY_ENABLED=false

# Reuse complete observations; source age/retention is never renewed by a hit.
SEARCH_CACHE_ENABLED=false
SEARCH_CACHE_TTL_SECONDS=1200
SEARCH_CACHE_MAX_ENTRIES=2000
SEARCH_CACHE_MAX_BYTES=20000000
# Request limits include full cache hits; provider-work job budgets stay separate.
MAX_HOURLY_SEARCH_REQUESTS=100
MAX_ACTIVE_SEARCH_REQUESTS=20
