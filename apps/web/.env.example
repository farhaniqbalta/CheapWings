# Base URL of the CheapWings backend API. For local dev with the loopback-only
# server (see repo root README.md), the default below needs no changes.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Owner bearer tokens are entered at runtime in the web UI. Never place secrets
# in VITE_* variables: they are embedded in the browser bundle.
