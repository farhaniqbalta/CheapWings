# Base URL of the CheapWings backend API. For local dev with the loopback-only
# server (see repo root README.md), the default below needs no changes.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Only required when the backend is NOT loopback-only (CHEAPWINGS_OWNER_TOKEN is
# set on the server). Never commit a real token; this file stays a template.
# VITE_OWNER_TOKEN=
